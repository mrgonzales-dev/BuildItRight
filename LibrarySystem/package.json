{
  "name": "library-system",
  "version": "1.0.0",
  "description": "Library Management System",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "concurrently -n api,web -c blue,green \"nodemon\" \"npm run dev --prefix client\"",
    "dev:api": "nodemon",
    "dev:web": "npm run dev --prefix client"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "nodemon": "^3.1.14"
  }
}
