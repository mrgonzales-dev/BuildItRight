{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "Simple e-commerce store with owner and customer roles",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "concurrently -n api,web -c blue,green \"nodemon\" \"npm run dev --prefix client\"",
    "dev:api": "nodemon",
    "dev:web": "npm run dev --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "nodemon": "^3.1.14"
  }
}
